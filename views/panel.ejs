<%- include('partials/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <h2 class="mb-0 fw-bold">📋 Panel de Tickets</h2>
  <span class="contador">🔔 Fallas registradas: <%= mensajes.length %></span>
</div>

<% if (mensajes.length === 0) { %>
  <div class="vacio">
    <div class="emoji-grande">🎉</div>
    <h3 class="mt-3 text-success fw-bold">¡Todo funciona correctamente!</h3>
    <p class="text-muted mb-0">No hay tickets pendientes por ahora. ¡Buen trabajo, equipo! 💪</p>
  </div>
<% } else { %>
  <div class="table-responsive tabla-tickets">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>ID</th>
          <th>👤 Solicitante</th>
          <th>📍 Aula / Ubicación</th>
          <th>💬 Descripción</th>
          <th>📅 Fecha</th>
          <th class="text-center">Acción</th>
        </tr>
      </thead>
      <tbody>
        <% mensajes.forEach(ticket => { %>
          <tr>
            <td><span class="badge bg-secondary"><%= ticket.id %></span></td>
            <td class="fw-semibold"><%= ticket.solicitante %></td>
            <td><%= ticket.ubicacion %></td>
            <td><%= ticket.descripcion %></td>
            <td><small class="text-muted"><%= ticket.fecha %></small></td>
            <td class="text-center">
              <form action="/panel/resolver" method="POST"
                    onsubmit="return confirm('¿Seguro que deseas marcar este ticket como resuelto?');">
                <input type="hidden" name="id" value="<%= ticket.id %>">
                <button type="submit" class="btn btn-resuelto btn-sm">✅ Resuelto</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/footer') %>