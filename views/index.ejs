<%- include('partials/header') %>

<div class="hero mb-5">
  <div class="hero-emoji">🖥️</div>
  <h1 class="display-4 mt-3">¡Bienvenido a HelpDesk!</h1>
  <p class="fs-5 text-muted col-md-8 mx-auto mt-3">
    Este es el servicio de soporte técnico del departamento de sistemas.
    Si encuentras una falla en un equipo, proyector, red o cualquier recurso tecnológico
    de la institución, repórtala aquí y nuestro equipo la atenderá lo antes posible.
  </p>
  <a href="/reportar" class="btn btn-divertido btn-lg mt-3">🚨 Reportar una falla</a>
</div>

<div class="row g-4">
  <div class="col-md-4 feature-wrapper">
    <div class="feature-card">
      <div class="icono">📝</div>
      <h5 class="mt-2">Reporta fácil</h5>
      <p class="text-muted mb-0">Llena el formulario con tu nombre, el aula y qué está fallando.</p>
    </div>
  </div>
  <div class="col-md-4 feature-wrapper">
    <div class="feature-card">
      <div class="icono">🔧</div>
      <h5 class="mt-2">Lo atendemos</h5>
      <p class="text-muted mb-0">El equipo de soporte revisa todos los reportes pendientes.</p>
    </div>
  </div>
  <div class="col-md-4 feature-wrapper">
    <div class="feature-card">
      <div class="icono">✅</div>
      <h5 class="mt-2">Problema resuelto</h5>
      <p class="text-muted mb-0">Cuando se repara, el ticket se marca como resuelto.</p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>